<ui:FluentWindow x:Class="RoninExplorer.App.KeybindSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Keybinds" Height="420" Width="360"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Keybinds" />

        <ItemsControl x:Name="ActionsList" Grid.Row="1" Margin="16,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ActionId}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Gesture}" VerticalAlignment="Center" FontFamily="Consolas" />
                        <Button Grid.Column="2" Content="Rebind" Padding="8,2" Click="Rebind_Click" Tag="{Binding ActionId}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,0,16,16">
            <TextBlock x:Name="StatusText" Text="Click Rebind, then press a key." Opacity="0.7" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Reset all to default" Padding="8,2" Margin="0,0,8,0" Click="ResetAll_Click" />
            <Button Content="Save" Padding="8,2" Click="Save_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
