<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RoninExplorer</AssemblyName>
    <RootNamespace>RoninExplorer.App</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Ronin Empire</Authors>
    <Description>Fast, customizable Windows file explorer.</Description>
    <Copyright>Copyright © 2026 Ronin Empire</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoninExplorer.Core\RoninExplorer.Core.csproj" />
  </ItemGroup>

</Project>
