<Application x:Class="RoninExplorer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RoninExplorer.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Fallback values for every DynamicResource key ThemeService can
                 swap — keeps the app looking correct even before a skin has
                 been applied (e.g. first paint, or if a skin file is missing). -->
            <SolidColorBrush x:Key="NavPaneBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FileListBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentBrush" Color="#3D5AFE" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="White" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
