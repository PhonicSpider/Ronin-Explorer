<ui:FluentWindow x:Class="RoninExplorer.App.ThemeSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Theme" Height="480" Width="380"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Theme" />

        <StackPanel Grid.Row="1" Margin="16,8,16,16">
            <TextBlock Text="Colors" FontWeight="Bold" Margin="0,0,0,8" />

            <TextBlock Text="Nav pane background (ARGB hex)" Opacity="0.7" FontSize="11" />
            <TextBox x:Name="NavPaneBackgroundBox" Margin="0,0,0,8" />

            <TextBlock Text="File list background (ARGB hex)" Opacity="0.7" FontSize="11" />
            <TextBox x:Name="FileListBackgroundBox" Margin="0,0,0,8" />

            <TextBlock Text="Details/Tools panel background (ARGB hex)" Opacity="0.7" FontSize="11" />
            <TextBox x:Name="PanelBackgroundBox" Margin="0,0,0,8" />

            <TextBlock Text="Accent color (ARGB hex)" Opacity="0.7" FontSize="11" />
            <TextBox x:Name="AccentColorBox" Margin="0,0,0,8" />

            <TextBlock Text="Background image (behind the file list)" FontWeight="Bold" Margin="0,12,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BackgroundImagePathBox" Grid.Column="0" Margin="0,0,4,0" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse..." Click="Browse_Click" />
            </Grid>
            <Button Content="Clear image" HorizontalAlignment="Left" Margin="0,4,0,8" Click="ClearImage_Click" />

            <TextBlock Text="Image opacity" Opacity="0.7" FontSize="11" />
            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal">
                <Button Content="Apply" Padding="10,4" Margin="0,0,8,0" Click="Apply_Click" />
                <Button Content="Reset to default" Padding="10,4" Click="ResetDefault_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
